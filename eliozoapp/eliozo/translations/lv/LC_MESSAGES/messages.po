#: templates/advanced_search_content.html:94
msgid ""
"The query must select the variable <code>?problemID</code>. The optional "
"variables <code>?section</code> and <code>?subsection</code> group the "
"problems under subtitles."
msgstr ""
"Vaicājumam jāatlasa mainīgais <code>?problemID</code>. Ar neobligātajiem "
"mainīgajiem <code>?section</code> un <code>?subsection</code> uzdevumus "
"sagrupē zem apakšvirsrakstiem."

#: templates/advanced_search_content.html:95
msgid "Ctrl+Enter starts the search."
msgstr "Ctrl+Enter sāk meklēšanu."

#: templates/advanced_search_content.html:100
msgid "Limit"
msgstr "Limits"

#: templates/advanced_search_content.html:103
#, python-format
msgid "at most %(max)s"
msgstr "ne vairāk kā %(max)s"

#: templates/advanced_search_content.html:106 templates/filter_content.html:215
#: templates/main_content.html:13
msgid "Search"
msgstr "Meklēt"

#: templates/advanced_search_content.html:124
#: templates/advanced_search_content.html:240
#, python-format
msgid "Syntax error at line %(line)s, column %(column)s"
msgstr "Sintakses kļūda %(line)s. rindā, %(column)s. pozīcijā"

#: templates/advanced_search_content.html:125
#, python-format
msgid "unexpected %(token)s"
msgstr "negaidīts %(token)s"

#: templates/advanced_search_content.html:126
msgid "the query ends too early"
msgstr "vaicājums beidzas par agru"

#: templates/advanced_search_content.html:127
msgid "expected one of"
msgstr "gaidīja kādu no"

#: templates/advanced_search_content.html:195
msgid "Replace the query in the text field?"
msgstr "Aizstāt teksta laukā esošo vaicājumu?"

#: templates/advanced_search_content.html:219
#, python-format
msgid "The limit must be a whole number from 1 to %(max)s."
msgstr "Limitam jābūt veselam skaitlim no 1 līdz %(max)s."

#: templates/advanced_search_content.html:226
msgid "Please enter a SPARQL query."
msgstr "Lūdzu, ievadiet SPARQL vaicājumu."

#: templates/advanced_search_content.html:228
msgid "The query is too long."
msgstr "Vaicājums ir pārāk garš."

#: templates/advanced_search_content.html:230
msgid "Only SELECT queries can be run."
msgstr "Var izpildīt tikai SELECT vaicājumus."

#: templates/advanced_search_content.html:232
msgid "Queries that change data are not allowed."
msgstr "Vaicājumi, kas maina datus, nav atļauti."

#: templates/advanced_search_content.html:234
msgid "SERVICE (federated queries) is not allowed."
msgstr "SERVICE (federētie vaicājumi) nav atļauts."

#: templates/advanced_search_content.html:236
msgid "The query must select the variable ?problemID."
msgstr "Vaicājumam jāatlasa mainīgais ?problemID."

#: templates/advanced_search_content.html:238
msgid "The query took too long and was stopped."
msgstr "Vaicājums izpildījās pārāk ilgi un tika apturēts."

#: templates/advanced_search_content.html:240
msgid "Syntax error"
msgstr "Sintakses kļūda"

#: templates/advanced_search_content.html:247
msgid "The query could not be run"
msgstr "Vaicājumu neizdevās izpildīt"

#: templates/advanced_search_content.html:255
msgid "Nothing was found."
msgstr "Nekas netika atrasts."

#: templates/advanced_search_content.html:258
#, python-format
msgid "Results: %(n)s"
msgstr "Rezultāti: %(n)s"

#: templates/advanced_search_content.html:259
msgid "The query has more results; increase the limit to see them."
msgstr "Vaicājumam ir vairāk rezultātu; palieliniet limitu, lai tos redzētu."

