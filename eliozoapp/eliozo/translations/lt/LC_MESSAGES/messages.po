#: templates/advanced_search_content.html:94
msgid ""
"The query must select the variable <code>?problemID</code>. The optional "
"variables <code>?section</code> and <code>?subsection</code> group the "
"problems under subtitles."
msgstr ""
"Užklausa turi pasirinkti kintamąjį <code>?problemID</code>. Neprivalomi "
"kintamieji <code>?section</code> ir <code>?subsection</code> sugrupuoja "
"uždavinius po paantraštėmis."

#: templates/advanced_search_content.html:95
msgid "Ctrl+Enter starts the search."
msgstr "Ctrl+Enter pradeda paiešką."

#: templates/advanced_search_content.html:100
