#: templates/advanced_search_content.html:219
#, python-format
msgid "The limit must be a whole number from 1 to %(max)s."
msgstr "Riba turi būti sveikasis skaičius nuo 1 iki %(max)s."

#: templates/advanced_search_content.html:226
msgid "Please enter a SPARQL query."
msgstr "Įveskite SPARQL užklausą."

#: templates/advanced_search_content.html:228
msgid "The query is too long."
msgstr "Užklausa per ilga."

#: templates/advanced_search_content.html:230
msgid "Only SELECT queries can be run."
msgstr "Galima vykdyti tik SELECT užklausas."

#: templates/advanced_search_content.html:232
msgid "Queries that change data are not allowed."
msgstr "Užklausos, keičiančios duomenis, neleidžiamos."

#: templates/advanced_search_content.html:234
msgid "SERVICE (federated queries) is not allowed."
msgstr "SERVICE (federacinės užklausos) neleidžiama."

#: templates/advanced_search_content.html:236
msgid "The query must select the variable ?problemID."
msgstr "Užklausa turi pasirinkti kintamąjį ?problemID."

#: templates/advanced_search_content.html:238
msgid "The query took too long and was stopped."
msgstr "Užklausa vykdyta per ilgai ir buvo sustabdyta."

#: templates/advanced_search_content.html:240
msgid "Syntax error"
msgstr "Sintaksės klaida"

#: templates/advanced_search_content.html:247
msgid "The query could not be run"
msgstr "Užklausos nepavyko įvykdyti"

#: templates/advanced_search_content.html:255
msgid "Nothing was found."
msgstr "Nieko nerasta."

